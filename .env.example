# Локальная разработка: админка работает на встроенной базе PGlite (.data/pglite),
# ничего настраивать не нужно. Первый вход: npm run admin:create -- --pglite
# 1 — включить GET /api/dev/login (вход без пароля под dev@webik.local, только в npm run dev)
DEV_AUTOLOGIN=0

# Доступ к Yandex AI Studio для ИИ-ассистента на сайте: API-ключ сервисного
# аккаунта (роль ai.languageModels.user) и идентификатор каталога (b1g…, не id
# сервисного аккаунта). Нужны оба, иначе чат выключен и виджет показывает форму.
# Читаются только на сервере (vite.config.ts, server/main.ts), в браузер не
# попадают — поэтому БЕЗ префикса VITE_. Никогда не добавляйте сюда префикс
# VITE_: Vite вшивает такие переменные в собранный фронтенд, и ключ станет
# публичным. Если переменные заданы в окружении (setx), здесь их можно не писать.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
