# Supabase — значения берутся в дашборде проекта:
# Project Settings → API → Project URL и Project API keys → anon public.
# Скопируйте этот файл в .env и подставьте свои значения. .env в репозиторий не коммитится.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Ключ Anthropic для чат-бота на сайте. Читается только на сервере
# (в vite.config.ts), в браузер не попадает — поэтому БЕЗ префикса VITE_.
# Никогда не добавляйте сюда префикс VITE_: Vite вшивает такие переменные
# в собранный фронтенд, и ключ станет публичным.
ANTHROPIC_API_KEY=
