# Локальная разработка: админка работает на встроенной базе PGlite (.data/pglite),
# ничего настраивать не нужно. Первый вход: npm run admin:create -- --pglite
# 1 — включить GET /api/dev/login (вход без пароля под dev@webik.local, только в npm run dev)
DEV_AUTOLOGIN=0

# Ключ Anthropic для чат-бота на сайте. Читается только на сервере
# (в vite.config.ts), в браузер не попадает — поэтому БЕЗ префикса VITE_.
# Никогда не добавляйте сюда префикс VITE_: Vite вшивает такие переменные
# в собранный фронтенд, и ключ станет публичным.
ANTHROPIC_API_KEY=
