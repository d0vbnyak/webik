{
  "name": "webik",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "tsx server/main.ts",
    "admin:create": "tsx server/cli/create-admin.ts",
    "build:server": "esbuild server/main.ts server/cli/create-admin.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outdir=build --entry-names=[name] --out-extension:.js=.mjs",
    "freelance": "tsx server/cli/freelance-watch.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@tailwindcss/vite": "^4.1.0",
    "defuddle": "^0.19.3",
    "hono": "^4.13.7",
    "linkedom": "^0.18.13",
    "motion": "^12.0.0",
    "nodemailer": "^10.0.10",
    "openai": "^6.49.0",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.17.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "ffmpeg-static": "^5.3.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.9"
  }
}
